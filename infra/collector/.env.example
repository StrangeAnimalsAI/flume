# Template for infra/collector/.env (real .env is gitignored repo-wide).
#
# Copy to `.env` and fill in. No placeholder strings ship to production —
# there is no production here, this is local dev only.

# Value for the Authorization header on the Langfuse OTLP export. Format:
# `Basic <base64(pk:sk)>`, no trailing newline. Construct with:
#
#   PK="$LANGFUSE_INIT_PROJECT_PUBLIC_KEY"   # from infra/langfuse/.env
#   SK="$LANGFUSE_INIT_PROJECT_SECRET_KEY"   # from infra/langfuse/.env
#   AUTH="Basic $(printf '%s:%s' "$PK" "$SK" | base64)"
#   echo "LANGFUSE_BASIC_AUTH=$AUTH"
#
# IMPORTANT: macOS `base64` emits without trailing newline by default. On
# Linux, pipe through `tr -d '\n'` to match.
LANGFUSE_BASIC_AUTH=replace-me

# Value written to the `host.name` resource attribute on every span that
# didn't already set one. Use something stable and human-readable — this
# becomes a Langfuse filter dimension.
HOST_NAME=replace-me

# Optional override. Defaults to the host-gateway URL from inside the
# collector container, which reaches the Langfuse stack running on the host.
# Do NOT point this at a containerized Langfuse via a shared docker network —
# that's a separate configuration and we keep the collector self-contained.
# LANGFUSE_OTLP_ENDPOINT=http://host.docker.internal:3000/api/public/otel
