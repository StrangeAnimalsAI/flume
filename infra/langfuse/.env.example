# Template for infra/langfuse/.env (which is gitignored).
# Copy this file to .env and fill in real values:
#
#     cp .env.example .env
#
# Every secret below is required; docker compose will refuse to start if any
# are missing (compose's `${VAR:?msg}` syntax enforces this).

# --- Langfuse app secrets ---------------------------------------------------

# Session/cookie signing for the Next.js auth layer.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me

# HMAC salt for hashed API keys stored in postgres.
# Generate with: openssl rand -base64 32
SALT=replace-me

# AES-256 key for encrypting LLM-provider credentials at rest.
# MUST be 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-me

# --- Datastore passwords ----------------------------------------------------

# Postgres password (user/db default to `postgres`/`postgres`).
# Use a URL-safe value — it ends up in DATABASE_URL below. `openssl rand -hex`
# keeps it alphanumeric. Base64 values would need percent-encoding.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-me

# Prisma connection string. Must match POSTGRES_PASSWORD above. The compose
# default in docker-compose.yml hard-codes `postgres:postgres@...`, so once you
# rotate POSTGRES_PASSWORD you MUST set DATABASE_URL here too.
DATABASE_URL=postgresql://postgres:replace-me@postgres:5432/postgres

# ClickHouse password (user defaults to `clickhouse`).
# Generate with: openssl rand -base64 24
CLICKHOUSE_PASSWORD=replace-me

# Redis AUTH string.
# Generate with: openssl rand -base64 24
REDIS_AUTH=replace-me

# MinIO root password (used by Langfuse for S3-compatible object storage).
# Generate with: openssl rand -base64 24
MINIO_ROOT_PASSWORD=replace-me

# The S3 event/media upload clients re-use the MinIO root credentials by
# default. Keep these two in sync with MINIO_ROOT_PASSWORD above.
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=replace-me
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=replace-me

# --- First-boot seeding (optional but recommended for local dev) -----------
#
# If set on the very first boot, Langfuse creates the org/project/user/API-key
# automatically and you can skip the UI sign-up flow. Ignored on subsequent
# boots once the records exist in postgres.

LANGFUSE_INIT_ORG_ID=agent-telemetry-org
LANGFUSE_INIT_ORG_NAME=agent-telemetry
LANGFUSE_INIT_PROJECT_ID=agent-telemetry-proj
LANGFUSE_INIT_PROJECT_NAME=agent-telemetry

# Public/secret API-key pair the backfill CLI authenticates with.
# Public key convention: pk-lf-<hex>. Secret key convention: sk-lf-<hex>.
# Generate with: echo "pk-lf-$(openssl rand -hex 16)" and "sk-lf-$(openssl rand -hex 32)"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-replace-me

# Seed user credentials for the web UI.
# Must validate as an email address (Langfuse uses zod email validation).
# `dev@localhost` won't pass; use a TLD suffix like `.test` or `.local`.
LANGFUSE_INIT_USER_EMAIL=dev@localhost.test
LANGFUSE_INIT_USER_NAME=Dev
# Generate with: openssl rand -base64 18
LANGFUSE_INIT_USER_PASSWORD=replace-me
