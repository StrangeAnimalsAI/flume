<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Claude Code Desktop -> local OTel Collector (flume).

  GUI macOS apps inherit env vars from the launchd user-domain session, NOT
  from your zsh `~/.zshrc`. To get telemetry into Claude Desktop, we register
  a one-shot LaunchAgent at login that sets every required variable via
  `launchctl setenv`. The variables persist for the user session until
  logout / `launchctl unsetenv`.

  No secrets here: the Collector holds Langfuse auth.

  Install (manual — review first, do NOT auto-load):

    cp recipes/claude-code-desktop.plist \
       ~/Library/LaunchAgents/io.flume-claude-code-desktop.plist
    launchctl load -w ~/Library/LaunchAgents/io.flume-claude-code-desktop.plist

    # Verify the env propagated into the user session:
    launchctl getenv CLAUDE_CODE_ENABLE_TELEMETRY    # -> 1
    launchctl getenv OTEL_RESOURCE_ATTRIBUTES        # -> source=claude-code-desktop

    # IMPORTANT: relaunch Claude Desktop. A running app already has the old
    # (empty) env baked in; setenv only affects future child processes of
    # launchd.
    osascript -e 'quit app "Claude"'  # or quit via the menu bar
    open -a "Claude"

  Smoke check after relaunch:
    1. Send any prompt in Claude Desktop.
    2. tail collector logs:
         docker compose -f infra/collector/docker-compose.yml logs --tail=100 otel-collector
       Look for incoming OTLP HTTP POSTs and successful forwards to
       host.docker.internal:3000.
    3. Open Langfuse at http://localhost:3000, filter traces by
       resource attribute source=claude-code-desktop.

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/io.flume-claude-code-desktop.plist
    rm ~/Library/LaunchAgents/io.flume-claude-code-desktop.plist
    # Clear any vars stuck in the current session:
    for v in CLAUDE_CODE_ENABLE_TELEMETRY CLAUDE_CODE_ENHANCED_TELEMETRY_BETA \
             OTEL_METRICS_EXPORTER OTEL_LOGS_EXPORTER OTEL_TRACES_EXPORTER \
             OTEL_EXPORTER_OTLP_PROTOCOL OTEL_EXPORTER_OTLP_ENDPOINT \
             OTEL_LOG_TOOL_DETAILS OTEL_LOG_TOOL_CONTENT \
             OTEL_METRIC_EXPORT_INTERVAL OTEL_LOGS_EXPORT_INTERVAL \
             OTEL_TRACES_EXPORT_INTERVAL OTEL_RESOURCE_ATTRIBUTES; do
      launchctl unsetenv "$v"
    done
    # Then relaunch Claude Desktop to drop the variables.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.flume-claude-code-desktop</string>

    <!--
      One shell invocation that chains all the launchctl setenv calls.
      Using /bin/sh -c keeps the plist a single ProgramArguments rather than
      one LaunchAgent per variable.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>/bin/launchctl setenv CLAUDE_CODE_ENABLE_TELEMETRY 1 &amp;&amp; /bin/launchctl setenv CLAUDE_CODE_ENHANCED_TELEMETRY_BETA 1 &amp;&amp; /bin/launchctl setenv OTEL_METRICS_EXPORTER none &amp;&amp; /bin/launchctl setenv OTEL_LOGS_EXPORTER none &amp;&amp; /bin/launchctl setenv OTEL_TRACES_EXPORTER otlp &amp;&amp; /bin/launchctl setenv OTEL_EXPORTER_OTLP_PROTOCOL http/protobuf &amp;&amp; /bin/launchctl setenv OTEL_EXPORTER_OTLP_ENDPOINT http://localhost:4318 &amp;&amp; /bin/launchctl setenv OTEL_LOG_TOOL_DETAILS 1 &amp;&amp; /bin/launchctl setenv OTEL_LOG_TOOL_CONTENT 1 &amp;&amp; /bin/launchctl setenv OTEL_TRACES_EXPORT_INTERVAL 2000 &amp;&amp; /bin/launchctl setenv OTEL_RESOURCE_ATTRIBUTES source=claude-code-desktop</string>
    </array>

    <!--
      RunAtLoad fires once when the LaunchAgent is loaded (login or manual
      launchctl load). KeepAlive is omitted: this is a one-shot setter, not
      a long-running service. Exit 0 is success.
    -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Capture stdout/stderr for first-time debugging. Safe to delete. -->
    <key>StandardOutPath</key>
    <string>/tmp/flume-claude-code-desktop.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/flume-claude-code-desktop.stderr.log</string>
</dict>
</plist>
